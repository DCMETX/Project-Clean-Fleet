rules_version = '2';
// Only signed-in users (accounts you create in Firebase Authentication) can read or write.
// Nobody can delete inspections or corrective actions from the app; that keeps an audit trail.
service cloud.firestore {
  match /databases/{database}/documents {
    match /inspections/{id} {
      allow read, create: if request.auth != null;
      allow update: if false;
      allow delete: if false;
    }
    match /correctiveActions/{id} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }
    match /config/{id} {
      allow read, write: if request.auth != null;
    }
    match /photos/{id} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
